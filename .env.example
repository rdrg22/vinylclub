# Firebase (Configuración del proyecto → Tus apps → app web → firebaseConfig).
# Son identificadores públicos; la seguridad la ponen las reglas de firestore.rules.
# Si se dejan vacías, la app arranca en MODO DEMOSTRACIÓN (sin cuentas).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Contacto incluido en el User-Agent de MusicBrainz (política de uso: https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting)
VITE_MUSICBRAINZ_CONTACT=
