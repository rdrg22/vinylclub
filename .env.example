# Supabase (Project Settings → API). Solo la clave pública "anon"; nunca la service_role.
# Si se dejan vacías, la app arranca en MODO DEMOSTRACIÓN con datos de ejemplo locales.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contacto incluido en el User-Agent de MusicBrainz (política de uso: https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting)
VITE_MUSICBRAINZ_CONTACT=
